{
  "name": "p5.js-svg-import",
  "version": "1.0.0",
  "description": "SVG import addon for p5.js",
  "type": "module",
  "main": "dist/p5.svg-import.js",
  "module": "dist/p5.svg-import.esm.js",
  "exports": {
    ".": {
      "import": "./dist/p5.svg-import.esm.js",
      "require": "./dist/p5.svg-import.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w"
  },
  "keywords": [
    "p5js",
    "svg",
    "import",
    "vector",
    "graphics"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "p5": ">=2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.0.0"
  }
}

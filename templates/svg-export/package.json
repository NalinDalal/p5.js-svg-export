{
  "name": "p5.js-svg-export",
  "version": "1.0.0",
  "description": "SVG export addon for p5.js",
  "type": "module",
  "main": "dist/p5.svg.js",
  "module": "dist/p5.svg.esm.js",
  "exports": {
    ".": {
      "import": "./dist/p5.svg.esm.js",
      "require": "./dist/p5.svg.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "p5js",
    "svg",
    "export",
    "vector",
    "graphics"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "p5": ">=2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "jsdom": "^29.1.1",
    "rollup": "^4.0.0",
    "vitest": "^4.1.9"
  }
}
